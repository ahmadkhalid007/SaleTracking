# Optional. Copy this file to .env in WhatsAppBridge.
WHATSAPP_BRIDGE_PORT=3210
WHATSAPP_SEND_DELAY_MS=3000
# Leave unset to use the automatically generated local token shared with ASP.NET.
# WHATSAPP_BRIDGE_API_KEY=generate_a_random_secret_at_least_32_characters_long
# Optional existing Chrome executable, otherwise Puppeteer's bundled browser is used.
# WHATSAPP_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
