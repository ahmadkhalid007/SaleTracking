{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Tracking": {
    "TimeZone": "Asia/Karachi"
  },
  "Database": {
    "Path": "../.local/saletracking.db"
  },
  "WhatsApp": {
    "Web": {
      "Enabled": true,
      "AutoStart": true,
      "BridgeDirectory": "../WhatsAppBridge",
      "DataDirectory": "../.local/whatsapp",
      "BridgeUrl": "http://127.0.0.1:3210",
      "TokenFile": "../.local/whatsapp/bridge-token"
    }
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "SenderEmail": "",
    "SenderName": "SaleTrack Alerts",
    "Username": "",
    "Password": ""
  }
}
