@model VerifyWhatsAppViewModel
@{ViewData["Title"]="Verify WhatsApp";var code=TempData["DemoCode"] as string;}
<div class="verify-card"><div class="verify-icon">✓</div><span class="eyebrow">ACCOUNT SECURITY</span><h1>Verify your WhatsApp</h1><p>@(TempData["Message"] ?? "Enter the six-digit code sent to your WhatsApp number.")</p>@if(code!=null){<div class="demo-code">Development mode: your code is <strong>@code</strong></div>}<form asp-action="VerifyWhatsApp" method="post"><input asp-for="Email" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Code">Verification code</label><input asp-for="Code" class="form-control code-input" maxlength="6" inputmode="numeric" placeholder="000000" autofocus/><span asp-validation-for="Code" class="text-danger"></span><button class="btn btn-primary w-100 mt-4">Verify and continue</button></form></div>
