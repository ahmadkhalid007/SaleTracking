@model IReadOnlyCollection<TrackingItem>

@functions {
    public static string FormatProductName(string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return "Tracked Product";
        try
        {
            if (Uri.TryCreate(url, UriKind.Absolute, out var uri))
            {
                var segments = uri.AbsolutePath.Trim('/').Split('/', StringSplitOptions.RemoveEmptyEntries);
                if (segments.Length > 0)
                {
                    var last = segments[^1];
                    if (last.All(char.IsDigit) && segments.Length > 1)
                    {
                        last = segments[^2];
                    }
                    if (!string.IsNullOrWhiteSpace(last) && last != "products" && last != "item")
                    {
                        var name = Uri.UnescapeDataString(last).Replace("-", " ").Replace("_", " ");
                        return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(name);
                    }
                }
                return uri.Host.Replace("www.", "");
            }
        }
        catch { }
        return url;
    }

    public static string TrimName(string name, int maxChars = 22)
    {
        if (string.IsNullOrWhiteSpace(name)) return "Product";
        return name.Length > maxChars ? name[..maxChars].TrimEnd() + "…" : name;
    }
}

<div class="dashboard-head d-flex flex-row justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <span class="eyebrow">MONITORING</span>
        <h1 class="mt-1 mb-0">Tracked Products</h1>
    </div>
@if (Model.Count > 0)
    {
        <div>
            <button type="button" class="btn btn-create-track" data-bs-toggle="modal" data-bs-target="#createTrackModal">
                <svg class="create-track-plus" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>Create New Track</span>
            </button>
        </div>
    }
</div>

<partial name="_Alerts" />

@if (Model.Count == 0)
{
    <section class="empty-state">
        <h2>No tracked products yet</h2>
        <p>Start monitoring your first product price to receive automated alerts.</p>
        <div class="mt-3">
            <button type="button" class="btn btn-create-track" data-bs-toggle="modal" data-bs-target="#createTrackModal">
                <svg class="create-track-plus" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>Create New Track</span>
            </button>
        </div>
    </section>
}
else
{
    <div class="card data-table-card tracked-products-card">
        <div class="card-header-flex">
            <div>
                <h2 class="card-title">All Tracked Products</h2>
                <p class="card-subtitle">Showing @Model.Count item@(Model.Count == 1 ? "" : "s") registered to your account</p>
            </div>
            <div class="table-search-box">
                <input type="text" id="trackSearchInput" class="form-control form-control-sm" placeholder="Filter by product name, URL..." />
            </div>
        </div>

        <div class="tracked-products-table-scroll">
            <table class="table tracking-table align-middle mb-0" id="trackingTable">
                <thead>
                    <tr>
                        <th scope="col" style="width: 28%;">Product</th>
                        <th scope="col" style="width: 14%;">Current Price</th>
                        <th scope="col" style="width: 14%;">Target Price</th>
                        <th scope="col" style="width: 14%;">Stock Status</th>
                        <th scope="col" style="width: 12%;">Created On</th>
                        <th scope="col" style="width: 9%; text-align: center;">Enable / Disable</th>
                        <th scope="col" style="width: 9%; text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var fullProductName = FormatProductName(item.ProductUrl);
                        var trimmedName = TrimName(fullProductName, 22);
                        var isTargetMet = item.CurrentPrice.HasValue && item.CurrentPrice.Value <= item.TargetPrice;

                        <tr class="tracking-row @(!item.IsActive ? "row-inactive" : "")">
                            <!-- 1. Clickable Trimmed Name + ↻ Check Icon -->
                            <td>
                                <div class="product-title-row">
                                    <a href="@item.ProductUrl" target="_blank" rel="noopener noreferrer" class="product-name-link" title="@fullProductName - Click to open product">
                                        @trimmedName
                                    </a>
                                    <form asp-controller="Dashboard" asp-action="CheckNow" method="post" class="d-inline m-0 p-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.TrackingId" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                        <button type="submit" class="btn-check-refresh" title="Check current price right now">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="23 4 23 10 17 10"></polyline>
                                                <polyline points="1 20 1 14 7 14"></polyline>
                                                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </td>

                            <!-- 2. Current Price -->
                            <td>
                                @if (item.CurrentPrice.HasValue)
                                {
                                    <span class="price-value current-price @(isTargetMet && item.CheckType != "InStock" ? "price-met" : "")">
                                        Rs. @item.CurrentPrice.Value.ToString("N2")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic fs-sm">Pending</span>
                                }
                            </td>

                            <!-- 3. Target Price -->
                            <td>
                                @if (item.CheckType == "InStock" && item.TargetPrice <= 0)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    <span class="price-value target-price">
                                        Rs. @item.TargetPrice.ToString("N2")
                                    </span>
                                }
                            </td>

                            <!-- 4. Stock Status (Dedicated Column) -->
                            <td>
                                @if (item.IsInStock == true)
                                {
                                    <span class="badge-status badge-active py-1 px-2.5">
                                        <span class="status-dot"></span> In Stock
                                    </span>
                                }
                                else if (item.IsInStock == false)
                                {
                                    <span class="badge-status badge-outofstock py-1 px-2.5">
                                        <span class="status-dot"></span> Out of Stock
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">Pending</span>
                                }
                            </td>

                            <!-- 5. Created On -->
                            <td>
                                <span class="date-text" title="@item.CreatedAt.ToLocalTime().ToString("f")">
                                    @item.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                                </span>
                            </td>

                            <!-- 5. Enable / Disable Switch -->
                            <td class="text-center">
                                <form asp-controller="Dashboard" asp-action="Toggle" method="post" class="d-inline-flex align-items-center justify-content-center m-0 p-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="trackingId" value="@item.TrackingId" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                    <button type="submit" class="track-toggle-switch @(item.IsActive ? "is-active" : "is-disabled")"
                                            title="@(item.IsActive ? "Enabled - Click to Disable" : "Disabled - Click to Enable")">
                                        <span class="switch-pill">
                                            <span class="switch-handle"></span>
                                        </span>
                                    </button>
                                </form>
                            </td>

                            <!-- 6. Actions: Edit, Delete, Three-Dot Menu -->
                            <td class="text-end">
                                <div class="action-btn-group">
                                    <!-- Edit Icon Button (opens popup modal with blur) -->
                                    <button type="button" class="btn-icon-action btn-edit" title="Edit tracking parameters"
                                            data-bs-toggle="modal" data-bs-target="#editTrackModal"
                                            data-id="@item.TrackingId"
                                            data-url="@item.ProductUrl"
                                            data-checktype="@item.CheckType"
                                            data-targetprice="@item.TargetPrice"
                                            data-interval="@item.CheckIntervalMinutes"
                                            data-startdate="@(item.StartDate?.ToString("yyyy-MM-dd") ?? "")"
                                            data-starttime="@(item.StartTime?.ToString("HH:mm") ?? "")"
                                            data-enddate="@(item.EndDate?.ToString("yyyy-MM-dd") ?? "")"
                                            data-endtime="@(item.EndTime?.ToString("HH:mm") ?? "")"
                                            data-disableafter="@(item.DisableAfterNotification ? "true" : "false")"
                                            data-isactive="@(item.IsActive ? "true" : "false")"
                                            onclick="populateEditTrackModal(this)">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                        </svg>
                                    </button>

                                    <!-- Delete Button -->
                                    <button type="button" class="btn-icon-action btn-delete" onclick="openDeleteModal('@item.TrackingId', '@fullProductName.Replace("'", "\\'")')" title="Delete tracker">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                            <line x1="10" y1="11" x2="10" y2="17"></line>
                                            <line x1="14" y1="11" x2="14" y2="17"></line>
                                        </svg>
                                    </button>

                                    <!-- Three-Dot (⋮) Dropdown Details Menu -->
                                    <div class="dropdown d-inline-block position-relative">
                                        <button class="btn-icon-action btn-more" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="More tracker details">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                                <circle cx="12" cy="5" r="2"></circle>
                                                <circle cx="12" cy="12" r="2"></circle>
                                                <circle cx="12" cy="19" r="2"></circle>
                                            </svg>
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-end shadow-lg details-popover-menu p-3">
                                            <div class="popover-header">Tracker Details</div>
                                            <div class="popover-detail-row">
                                                <span class="label">Tracking ID</span>
                                                <span class="val font-monospace small">@item.TrackingId</span>
                                            </div>
                                            <div class="popover-detail-row">
                                                <span class="label">Status</span>
                                                <span class="val">
                                                    @if (item.IsNotified)
                                                    {
                                                        <span class="badge-status badge-notified py-1 px-2"><span class="status-dot"></span> Alert submitted</span>
                                                    }
                                                    else if (item.IsActive)
                                                    {
                                                        <span class="badge-status badge-active py-1 px-2"><span class="status-dot"></span> Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge-status badge-disabled py-1 px-2"><span class="status-dot"></span> Disabled</span>
                                                    }
                                                </span>
                                            </div>
                                            <div class="popover-detail-row">
                                                <span class="label">Alert Condition</span>
                                                <span class="val fw-bold text-primary">@item.CheckTypeDisplay</span>
                                            </div>
                                            <div class="popover-detail-row">
                                                <span class="label">Stock Status</span>
                                                <span class="val">
                                                    @if (item.IsInStock == true)
                                                    {
                                                        <span class="badge-status badge-active py-1 px-2"><span class="status-dot"></span> In Stock</span>
                                                    }
                                                    else if (item.IsInStock == false)
                                                    {
                                                        <span class="badge-status badge-outofstock py-1 px-2"><span class="status-dot"></span> Out of Stock</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small fst-italic">Checking...</span>
                                                    }
                                                </span>
                                            </div>
                                            <div class="popover-detail-row">
                                                <span class="label">Timer Interval</span>
                                                <span class="val">@(item.CheckIntervalMinutes == 1 ? "1 min" : $"{item.CheckIntervalMinutes} mins")</span>
                                            </div>
                                            <div class="popover-detail-row">
                                                <span class="label">Date & Time (@TrackingSchedule.DisplayName)</span>
                                                <span class="val">
                                                    @if (item.StartDate.HasValue && item.EndDate.HasValue)
                                                    {
                                                        @($"{item.StartDate:yyyy-MM-dd}{(item.StartTime.HasValue ? $" {item.StartTime:HH:mm}" : "")} → {item.EndDate:yyyy-MM-dd}{(item.EndTime.HasValue ? $" {item.EndTime:HH:mm}" : "")}")
                                                    }
                                                    else if (item.StartDate.HasValue)
                                                    {
                                                        @($"From {item.StartDate:yyyy-MM-dd}{(item.StartTime.HasValue ? $" {item.StartTime:HH:mm}" : "")}")
                                                    }
                                                    else
                                                    {
                                                        @if (item.EndDate.HasValue)
                                                        {
                                                            @($"Until {item.EndDate:yyyy-MM-dd} {item.EndTime:HH:mm}")
                                                        }
                                                        else if (item.StartTime.HasValue || item.EndTime.HasValue)
                                                        {
                                                            @($"Daily {item.StartTime?.ToString("HH:mm") ?? "00:00"} → {item.EndTime?.ToString("HH:mm") ?? "23:59"}")
                                                        }
                                                        else
                                                        {
                                                            <text>Continuous</text>
                                                        }
                                                    }
                                                </span>
                                            </div>
                                            @if (item.LastCheckedAt.HasValue)
                                            {
                                                <div class="popover-detail-row">
                                                    <span class="label">Last Checked</span>
                                                    <span class="val text-muted small">@item.LastCheckedAt.Value.ToLocalTime().ToString("g")</span>
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(item.LastAlertError) || !string.IsNullOrWhiteSpace(item.LastCheckError))
                                            {
                                                <div class="alert alert-warning py-1 px-2 small mt-2 mb-1">
                                                    @(item.LastAlertError ?? item.LastCheckError)
                                                </div>
                                            }
                                            <hr class="my-2" />
                                            <button type="button" class="btn btn-sm btn-outline-secondary w-100 mb-2 d-flex align-items-center justify-content-center gap-1"
                                                    data-bs-toggle="modal" data-bs-target="#editTrackModal"
                                                    data-id="@item.TrackingId"
                                                    data-url="@item.ProductUrl"
                                                    data-checktype="@item.CheckType"
                                                    data-targetprice="@item.TargetPrice"
                                                    data-interval="@item.CheckIntervalMinutes"
                                                    data-startdate="@(item.StartDate?.ToString("yyyy-MM-dd") ?? "")"
                                                    data-starttime="@(item.StartTime?.ToString("HH:mm") ?? "")"
                                                    data-enddate="@(item.EndDate?.ToString("yyyy-MM-dd") ?? "")"
                                                    data-endtime="@(item.EndTime?.ToString("HH:mm") ?? "")"
                                                    data-disableafter="@(item.DisableAfterNotification ? "true" : "false")"
                                                    data-isactive="@(item.IsActive ? "true" : "false")"
                                                    onclick="populateEditTrackModal(this)">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                                </svg>
                                                <span>Edit Parameters</span>
                                            </button>
                                            <a asp-controller="Dashboard" asp-action="Details" asp-route-id="@item.TrackingId" class="btn btn-sm btn-outline-primary w-100">
                                                Full Tracker Breakdown →
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true" data-bs-backdrop="true">
    <div class="modal-dialog modal-dialog-centered modal-blur-dialog">
        <div class="modal-content modal-blur-content delete-modal-content">
            <div class="modal-blur-header">
                <h5 class="modal-blur-title text-danger d-flex align-items-center gap-2" id="deleteModalLabel">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    Confirm Deletion
                </h5>
                <button type="button" class="modal-blur-close" data-bs-dismiss="modal" aria-label="Close">✕</button>
            </div>
            <div class="modal-blur-body">
                <p>Are you sure you want to delete tracking for <strong id="deleteTargetName"></strong>?</p>
                <p class="text-muted small mb-0">Tracking ID: <span id="deleteTargetId" class="font-monospace text-danger"></span></p>
                <p class="text-muted small mt-2 mb-0">This tracker will permanently stop monitoring price updates. This action cannot be undone.</p>
            </div>
            <div class="modal-footer border-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" asp-controller="Dashboard" asp-action="Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteTrackingIdInput" name="id" value="" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <button type="submit" class="btn btn-danger">Delete Tracker</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function openDeleteModal(id, name) {
        const idEl = document.getElementById('deleteTargetId');
        if (idEl) idEl.textContent = id;
        const nameEl = document.getElementById('deleteTargetName');
        if (nameEl) nameEl.textContent = name || id;
        const inputEl = document.getElementById('deleteTrackingIdInput');
        if (inputEl) inputEl.value = id;
        const modalEl = document.getElementById('deleteModal');
        if (window.bootstrap && window.bootstrap.Modal) {
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        } else {
            if (confirm('Are you sure you want to delete tracker ' + (name || id) + '?')) {
                document.getElementById('deleteForm').submit();
            }
        }
    }

    // Live table search/filter
    document.getElementById('trackSearchInput')?.addEventListener('input', function(e) {
        const query = e.target.value.toLowerCase().trim();
        const rows = document.querySelectorAll('#trackingTable tbody tr');
        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            row.style.display = text.includes(query) ? '' : 'none';
        });
        dismissAllTrackerPopovers();
    });

    function dismissAllTrackerPopovers() {
        document.querySelectorAll('.btn-more').forEach(function(btn) {
            if (window.bootstrap && window.bootstrap.Dropdown) {
                const inst = bootstrap.Dropdown.getInstance(btn);
                if (inst) inst.hide();
            }
        });
    }

    function initTrackerDropdowns() {
        const moreButtons = document.querySelectorAll('.btn-more');
        moreButtons.forEach(function(button) {
            if (window.bootstrap && window.bootstrap.Dropdown) {
                new bootstrap.Dropdown(button, {
                    popperConfig: function(defaultConfig) {
                        return {
                            ...defaultConfig,
                            strategy: 'fixed'
                        };
                    }
                });
            }
        });

        const tableScroll = document.querySelector('.tracked-products-table-scroll');
        if (tableScroll) {
            tableScroll.addEventListener('scroll', dismissAllTrackerPopovers, { passive: true });
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTrackerDropdowns);
    } else {
        initTrackerDropdowns();
    }
</script>
